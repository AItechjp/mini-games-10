{
  // Optional separate deployment. No routes or domains are bound by this config.
  // Build the current public bundle first, including Commons and public vendors.
  "name": "aitech-subdomains",
  "main": "./subdomain-worker.mjs",
  "compatibility_date": "2026-10-04",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "404-page"
  }
}
